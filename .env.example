# Copie este arquivo para ".env.local" e preencha com as credenciais
# do SEU projeto Supabase (Project Settings → API).
#
# NUNCA coloque valores reais neste arquivo .env.example — ele é
# versionado no Git. Valores reais vão só no .env.local (ignorado
# pelo .gitignore) ou nas variáveis de ambiente do Netlify.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI
